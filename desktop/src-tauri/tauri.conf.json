{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONI RCON",
  "version": "1.0.1",
  "identifier": "net.archelabs.oni-rcon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ONI RCON",
        "width": 1600,
        "height": 940,
        "minWidth": 980,
        "minHeight": 620,
        "backgroundColor": "#06080B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
